# 🌾 MandiSense Environment Variables Template
# Copy this file to a new file named '.env' inside 'mandisense/backend' and configure your API keys.

# 🔑 Google Gemini AI API Configuration
# Used for natural-language business summaries and recommendations explanation.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ☁️ OpenWeather API Configuration
# Used for real-time weather alerts, rainfall levels, and temperature metrics.
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# 🗺️ Google Maps API Configuration
# Used for geocoding address searches and matching the closest regional mandi.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 🌾 Live Mandi Price API Configuration
# Used to fetch actual government daily agricultural prices.
MANDI_API_KEY=YOUR_LIVE_MANDI_API_KEY_HERE

# ⚡ Supabase Configuration
# Used for database replication, syncing, and vendor identity management.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 🔥 Firebase Configuration
# Used for cloud authentication services.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
